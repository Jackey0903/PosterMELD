OPENAI_API_KEY=your_key_here

# Optional: use these only when enabling VLM or image refinement.
VLM_API_KEY=your_vlm_gateway_key
VLM_BASE_URL=https://your-vlm-endpoint
VLM_MODEL=gpt-5.1

IMAGE_API_KEY=your_image_gateway_key
IMAGE_BASE_URL=https://your-image-endpoint
IMAGE_MODEL=gemini-2.5-flash-image

# Optional: MinerU precise PDF parsing. Keep the real key only in local .env.
MINERU_API_KEY=your_mineru_key
MINERU_MODEL_VERSION=vlm
